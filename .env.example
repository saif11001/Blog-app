# MongoDB Atlas connection string (the app uses the "Blogs" database)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/

# Password for the admin panel
ADMIN_PASSWORD=

# Optional: secret used to sign the admin session cookie (falls back to ADMIN_PASSWORD)
SESSION_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
